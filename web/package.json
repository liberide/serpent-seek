{
  "name": "serpentseek-web",
  "private": true,
  "version": "1.1.2",
  "license": "GPL-3.0-only",
  "type": "module",
  "scarfSettings": {
    "enabled": false
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "postbuild": "node -e \"require('node:fs').writeFileSync('build/.keep', 'Placeholder tracked in git so //go:embed all:build always has a file. See web/embed.go.\\n')\"",
    "preview": "vite preview",
    "pretest": "svelte-kit sync",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "svelte-kit sync && node scripts/check-i18n.mjs && node scripts/check-openapi.mjs && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "js-yaml": "^5.4.3",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@xyflow/svelte": "1.7.0",
    "swagger-ui-dist": "^5.33.3",
    "uqr": "^0.1.3"
  }
}
