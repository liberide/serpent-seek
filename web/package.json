{
  "name": "serpentseek-web",
  "private": true,
  "version": "1.1.4",
  "license": "GPL-3.0-only",
  "type": "module",
  "scarfSettings": {
    "enabled": false
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "postbuild": "node -e \"require('node:fs').writeFileSync('build/.keep', 'Placeholder tracked in git so //go:embed all:build always has a file. See web/embed.go.\\n')\"",
    "preview": "vite preview",
    "pretest": "svelte-kit sync",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "svelte-kit sync && node scripts/check-i18n.mjs && node scripts/check-openapi.mjs && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "js-yaml": "^5.5.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@xyflow/svelte": "^1.7.1",
    "swagger-ui-dist": "^5.34.1",
    "uqr": "^0.1.3"
  }
}
