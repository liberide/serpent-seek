# SerpentSeek configuration.
# Copy to .env and adjust. Every value can also be changed in the UI unless it
# is pinned by an environment variable (the UI marks such fields as "env").
# SearXNG is an external service: only its URL/token are configured here.

# --- General ---------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
DATA_DIR=/app/data
# SQLITE_PATH defaults to ${DATA_DIR}/serpentseek.db
LOG_LEVEL=info
LOG_FORMAT=text

# --- Storage ---------------------------------------------------------------
# sqlite (default) or postgres
STORAGE_DRIVER=sqlite
# DATABASE_URL is required when STORAGE_DRIVER=postgres
# DATABASE_URL=postgres://serpent:secret@postgres:5432/serpentseek?sslmode=disable
# Only needed with the "extdb" compose profile
POSTGRES_PASSWORD=change-me
# Optional: encrypt stored secrets at rest (AES-256-GCM). 32 bytes, hex/base64.
# ENCRYPTION_KEY=

# --- Auth ------------------------------------------------------------------
AUTH_ENABLED=true
# Hide the sidebar warning shown while authentication is disabled.
HIDE_AUTH_OFF_NOTICE=false
# Required for passkeys (WebAuthn needs HTTPS + a domain). Example:
# PUBLIC_ORIGIN=https://seek.example.com
# RP_ID=seek.example.com
RP_NAME=SerpentSeek
# Optional fixed setup token; when empty a random one is printed once to the log.
# SETUP_TOKEN=

# --- Retention / jobs ------------------------------------------------------
HISTORY_RETENTION_DAYS=30
LOGS_RETENTION_DAYS=14
# Daily search-quota counters and audit trail retention (0 disables pruning).
USAGE_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=180
# 0 disables deletion
HISTORY_CLEANUP_CRON=0 4 * * *
VACUUM_CRON=0 3 * * 0

# --- Network / chain engine ------------------------------------------------
MAX_CONCURRENCY=32
MAX_ATTEMPTS=10
USER_AGENT=
TREAT_EMPTY_AS_FAIL=true
# Search throttling for /search, /mcp and the playground (0 disables each).
# Subjects are API keys (sessions/anonymous installs fall back to user/IP).
# SEARCH_RATE_LIMIT_PER_MINUTE=60
# SEARCH_DAILY_QUOTA=1000
# Hard wall-clock limit for one search across the whole chain (seconds, 0 = off).
# CHAIN_TIMEOUT=120
# Circuit breaker: skip a provider after N consecutive failures for M seconds.
# PROVIDER_FAILURE_THRESHOLD=3
# PROVIDER_COOLDOWN_SECONDS=60
# Enable Go pprof profiling under /debug/pprof.
# DEBUG=false
# Mix answer-node sources (link+title, often no snippet) into the Row result.
ALLOW_SPARSE_SOURCES=false
# Comma-separated proxy IPs/CIDRs whose forwarded headers are trusted.
# TRUSTED_PROXIES=10.0.0.1,172.18.0.0/16
# Restrict outbound connections to public addresses.
BLOCK_PRIVATE_NETWORKS=false

# --- Updates ---------------------------------------------------------------
# Check the GitHub release feed for a newer version and show a notice in the UI.
# Disable for air-gapped/privacy-sensitive setups.
UPDATE_CHECK_ENABLED=true
# The release feed URL can ONLY be set here (never from the UI). A non-default
# value marks the instance as "unofficial" in the UI.
UPDATE_CHECK_URL=https://api.github.com/repos/liberide/serpent-seek/releases/latest
UPDATE_CHECK_INTERVAL_HOURS=24
# Optional outbound webhook: receives a JSON POST on provider circuit-breaker
# trips and daily quota exhaustion. Leave empty to disable.
# WEBHOOK_URL=https://example.com/serpentseek-hook

# --- OpenTelemetry (optional) ----------------------------------------------
# Set an OTLP/HTTP endpoint to export request traces (spans). Unset = disabled.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=serpentseek

# --- Providers -------------------------------------------------------------
# Error codes (global defaults; per-instance overrides live on the Providers screen)
# Fatal-code tables (fatal_codes / fatal_http) are per-instance params of each provider.
RETRY_HTTP_CODES=429,500,502,503,504
AP_RETRY_CODES=

# apiserpent
APISERPENT_API_KEY=
# Alternate legacy name for the same value
SERPENT_API_KEY=
# serpbase.dev
SERPBASE_API_KEY=

# SearXNG (always an EXTERNAL instance; no container is shipped with SerpentSeek)
# Plain URL (http://host:port/search) or a template with {query}/<query>.
# Also editable in the Providers UI without a restart.
SEARXNG_URL=
SEARXNG_API_KEY=
SEARXNG_LANGUAGE=
# Optional: example config for your own externally hosted instance, see deploy/searxng/settings.yml
# SEARXNG_SECRET_KEY=

# Yandex Search API v2 (Yandex Cloud)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# NCBI E-utilities (PubMed); optional, raises the 3 rps limit to 10 rps
NCBI_API_KEY=

# Google: primary is Gemini grounding / Vertex, legacy CSE is deprecated
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash
GOOGLE_CX=
GOOGLE_DRIVER=vertex
