# SerpentSeek configuration.
# Copy to .env and adjust. Every value can also be changed in the UI unless it
# is pinned by an environment variable (the UI marks such fields as "env").
# SearXNG is an external service: only its URL/token are configured here.

# --- General ---------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
DATA_DIR=/app/data
# SQLITE_PATH defaults to ${DATA_DIR}/serpentseek.db
LOG_LEVEL=info
LOG_FORMAT=text

# --- Storage ---------------------------------------------------------------
# sqlite (default) or postgres
STORAGE_DRIVER=sqlite
# DATABASE_URL is required when STORAGE_DRIVER=postgres
# DATABASE_URL=postgres://serpent:secret@postgres:5432/serpentseek?sslmode=disable
# Only needed with the "extdb" compose profile
POSTGRES_PASSWORD=change-me
# Optional: encrypt provider credentials at rest (AES-GCM). 32 bytes, hex/base64.
# ENCRYPTION_KEY=

# --- Auth ------------------------------------------------------------------
AUTH_ENABLED=true
# Hide the sidebar warning shown while authentication is disabled.
HIDE_AUTH_OFF_NOTICE=false
# Required for passkeys (WebAuthn needs HTTPS + a domain). Example:
# PUBLIC_ORIGIN=https://seek.example.com
# RP_ID=seek.example.com
RP_NAME=SerpentSeek
# Optional fixed setup token; when empty a random one is printed once to the log.
# SETUP_TOKEN=

# --- Retention / jobs ------------------------------------------------------
HISTORY_RETENTION_DAYS=30
LOGS_RETENTION_DAYS=14
# 0 disables deletion
HISTORY_CLEANUP_CRON=0 4 * * *
VACUUM_CRON=0 3 * * 0

# --- Network / chain engine ------------------------------------------------
MAX_CONCURRENCY=32
MAX_ATTEMPTS=10
USER_AGENT=
TREAT_EMPTY_AS_FAIL=true
# Mix answer-node sources (link+title, often no snippet) into the Row result.
ALLOW_SPARSE_SOURCES=false

# --- Providers -------------------------------------------------------------
# Error codes (global defaults; per-instance overrides live on the Providers screen)
# Fatal-code tables (fatal_codes / fatal_http) are per-instance params of each provider.
RETRY_HTTP_CODES=429,500,502,503,504
AP_RETRY_CODES=

# apiserpent
APISERPENT_API_KEY=
# Alternate legacy name for the same value
SERPENT_API_KEY=
# serpbase.dev
SERPBASE_API_KEY=

# SearXNG (always an EXTERNAL instance; no container is shipped with SerpentSeek)
# Plain URL (http://host:port/search) or a template with {query}/<query>.
# Also editable in the Providers UI without a restart.
SEARXNG_URL=
SEARXNG_API_KEY=
SEARXNG_LANGUAGE=
# Optional: example config for your own externally hosted instance, see deploy/searxng/settings.yml
# SEARXNG_SECRET_KEY=

# Yandex Search API v2 (Yandex Cloud)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# NCBI E-utilities (PubMed); optional, raises the 3 rps limit to 10 rps
NCBI_API_KEY=

# Google: primary is Gemini grounding / Vertex, legacy CSE is deprecated
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
GOOGLE_CX=
GOOGLE_DRIVER=vertex
